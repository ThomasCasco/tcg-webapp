NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Platform commission. 0 = no commission (launch period).
PLATFORM_FEE_PERCENT=0
# Optional minimum commission in ARS when the percent is above 0.
PLATFORM_FEE_MIN_ARS=0

MP_APP_ID=
MP_CLIENT_SECRET=
MP_ACCESS_TOKEN=
MP_REDIRECT_URI=http://localhost:3000/api/auth/mercadopago/callback
MP_WEBHOOK_SECRET=

CRON_SECRET=
ADMIN_SECRET=

# Optional: without it emails are skipped and only in-app notifications go out.
RESEND_API_KEY=
# Must be on a domain verified in Resend to reach real users.
EMAIL_FROM=TCG Marketplace AR <onboarding@resend.dev>

# Optional: shown to users in disputes as the contact address.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Leave unset for v0. "1" re-enables auctions, claims, trades and /profiles.
ENABLE_SECONDARY_FORMATS=
